# Network Configuration
STACKS_NETWORK=mainnet

# Funder wallet
# Use placeholders only. Never store a real mnemonic in this file.
FUNDER_MNEMONIC=your twenty four word mnemonic phrase here
FUNDER_ADDRESS=SPXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Deployer wallet (can be the same as the funder)
DEPLOYER_MNEMONIC=your twenty four word mnemonic phrase here
DEPLOYER_ADDRESS=SPYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY

# Contract details
CONTRACT_NAME=achievement-poap

# API endpoints
STACKS_API_URL=https://api.mainnet.hiro.so
